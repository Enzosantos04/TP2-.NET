@page
@model TP2Razor.Pages.CityManager.Exercicio02.CreateCityModel
@{
    ViewData["Title"] = "Exercício 02 — Parâmetro no handler";
}
<h1>Exercício 02 — Parâmetro no handler</h1>

<form method="post">
    <label for="cityName">Nome da cidade</label>
    <input id="cityName" name="cityName" />
    <button type="submit">Enviar cidade</button>
</form>
@if (Model.Message != null)
{
    <p class="result">@Model.Message</p>
}
